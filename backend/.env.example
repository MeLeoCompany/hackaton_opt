DATABASE_URL=postgresql+asyncpg://routing:routing@localhost:5432/routing
CUOPT_TIME_LIMIT_SECONDS=1.0
CUOPT_MAX_TIME_LIMIT_SECONDS=120.0
# Последний уровень objective: 0 отключает выбор по пробегу, 1 — базовый вес.
CUOPT_DISTANCE_WEIGHT=1.0
# Подпись токенов входа. В любом общем окружении задайте свою длинную случайную строку:
# с известным секретом токен администратора можно подделать.
AUTH_SECRET=dev-secret-change-me
AUTH_TOKEN_HOURS=12
