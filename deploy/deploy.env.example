# Что нужно предоставить для развёртывания на сервере.
# Скопируйте этот файл в deploy/deploy.env и заполните. deploy.env в git не попадает.
#
#   cp deploy/deploy.env.example deploy/deploy.env
#   ./deploy/deploy.sh
#
# Для локального запуска (без сервера, DNS и сертификата) этот файл не нужен:
# см. deploy/LOCAL.md.

# --- Сервер -----------------------------------------------------------------
# Адрес и доступ по SSH. Пароль или ключ — что-то одно; ключ надёжнее.
SERVER_HOST=203.0.113.10
SERVER_USER=root
SERVER_PORT=22
SERVER_SSH_KEY=~/.ssh/id_ed25519
SERVER_PASSWORD=
# Куда положить проект на сервере. По умолчанию в домашний каталог пользователя:
# так не нужны права на /opt и docker не упрётся в чужого владельца файлов
DEPLOY_PATH=~/routing

# --- Откуда брать код -------------------------------------------------------
# Сервер сам забирает репозиторий: первый запуск — clone, дальше — fetch и reset
# на нужную ветку.
REPO_URL=https://github.com/MeLeoCompany/hackaton_opt.git
REPO_BRANCH=main
# Токен GitHub для приватного репозитория. На сервере не сохраняется: он передаётся
# только на время git-команды и стирается сразу после неё.
# Fine-grained токен на этот репозиторий, прав достаточно Contents → Read.
# Публичный репозиторий — оставьте пустым.
GITHUB_TOKEN=

# --- Домен и сертификат -----------------------------------------------------
# DOMAIN должен уже указывать A-записью на SERVER_HOST — сертификат выдаётся по нему.
# Без домена поставьте TLS=false: система откроется по http://SERVER_HOST.
DOMAIN=routing.example.com
TLS=true
# Почта для Let's Encrypt: туда придёт письмо, если сертификат перестанет обновляться
ACME_EMAIL=ops@example.com

# --- Секреты ----------------------------------------------------------------
# Пароль БД и подпись токенов входа. Сгенерируйте свои:
#   openssl rand -hex 24
DB_PASSWORD=
AUTH_SECRET=

# --- Что разворачивать ------------------------------------------------------
# Общественный транспорт (R5). Тяжёлый: около 5 ГБ памяти и долгий первый старт
TRANSIT=true
# Видеокарта NVIDIA для решателя cuOpt. Без неё расчёт идёт на OR-Tools (процессор).
# На сервере должен стоять драйвер NVIDIA (ubuntu-drivers install, проверка nvidia-smi);
# CUDA Toolkit ставить не нужно — CUDA идёт внутри образа бэкенда. Контейнерный тулкит
# скрипт поставит сам. Если видеокарты не окажется, развернётся без неё и скажет об этом
GPU=true
# Поставить docker и nvidia-container-toolkit на сервер, если их там нет
INSTALL_DOCKER=true
