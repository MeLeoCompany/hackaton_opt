# Настройки локального запуска. Скопируйте в .env рядом с docker-compose.yml:
#
#   cp .env.example .env
#
# Все поля необязательные: без файла система поднимется на значениях по умолчанию.
# Файл .env в git не попадает — в нём пароли.
# Для развёртывания на сервере тот же смысл имеют поля deploy/deploy.env.

# --- Вход -------------------------------------------------------------------
# Пароль администратора (логин admin). В миграциях его нет: он ставится при старте
# бэкенда из этой переменной. Не задан — будет «admin», и приложение напишет об этом
# в журнал при каждом запуске
ADMIN_PASSWORD=admin

# Подпись токенов входа. Сменить — значит разлогинить всех, кто сейчас в системе.
# Для общего стенда сгенерируйте свою строку:  openssl rand -hex 24
AUTH_SECRET=dev-secret-change-me

# --- Куда фронтенд ходит за API ---------------------------------------------
# По умолчанию внутрь compose, к сервису backend. Пригодится, когда бэкенд
# запускают на хосте, а интерфейс — в контейнере
# VITE_API_TARGET=http://host.docker.internal:8000

# --- Расчёт -----------------------------------------------------------------
# Сколько секунд решателю cuOpt искать решение: нижняя граница и потолок для больших дней
# CUOPT_TIME_LIMIT_SECONDS=1.0
# CUOPT_MAX_TIME_LIMIT_SECONDS=120.0
# Насколько пробег влияет на выбор между равными по заявкам планами
# CUOPT_DISTANCE_WEIGHT=1.0

# --- Общественный транспорт -------------------------------------------------
# Скорость пешехода и терпение к долгому ответу R5
# R5_WALKING_SPEED_KMH=4.8
# R5_TIMEOUT_SECONDS=180
